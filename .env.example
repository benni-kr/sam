# 1. Required for runtime connection to Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 2. Database Partitioning (The "Scope" Trick)
# SAM uses this scope to partition records within the exact same Supabase database.
# This prevents different environments from colliding or accidentally deleting real events.
#
# -> For the live Vercel production app:
# NEXT_PUBLIC_SAM_PLANNER_SCOPE=prod
#
# -> CRITICAL FOR LOCAL DEV: Change 'default' to your name (e.g., dev-paul, dev-miriam)
# so your local tests do not overwrite or delete the production calendar data!
NEXT_PUBLIC_SAM_PLANNER_SCOPE=default
# 3. Web Push Notifications
# Generate a keypair once with:  npx web-push generate-vapid-keys
# The PUBLIC key is safe to ship to the browser; the PRIVATE key is a server
# secret and must NEVER be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Server-only Supabase key used by /api/notify to read + prune subscriptions.
# Bypasses RLS, so keep it secret and server-side only (no NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
