# ==============================================================================
# SAM Environment Variables Template
# Copy this file to `.env` (or `.env.local`) and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration
# Find these in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ------------------------------------------------------------------------------
# 2. Database Partitioning (Scope)
# Partitions calendar events and push subscriptions within the shared database.
# - Production (Vercel): Set to 'prod'
# - Local Development: Set to your name (e.g. 'dev-alex') so your local test
#   events and notifications never mix with production data.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SAM_PLANNER_SCOPE=default

# ------------------------------------------------------------------------------
# 3. Web Push Notifications (VAPID Keys)
# Generate a new keypair by running:  npx web-push generate-vapid-keys
# ------------------------------------------------------------------------------
# Public key: Sent to the browser to register push subscriptions (Safe to expose)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Private key: Used on the server to sign outgoing notifications (SECRET)
VAPID_PRIVATE_KEY=your-vapid-private-key

# (Optional) Contact email for push gateways (Apple / Google)
# VAPID_SUBJECT=mailto:admin@example.com

# ------------------------------------------------------------------------------
# 4. Server-Only Supabase Secret
# Find in: Supabase Dashboard -> Project Settings -> API -> service_role key
# Required by /api/notify to manage push subscriptions (bypasses RLS).
# NEVER expose this key to the browser (never prefix with NEXT_PUBLIC_).
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

